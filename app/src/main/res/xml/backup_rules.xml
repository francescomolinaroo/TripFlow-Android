<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup per Android 11 e precedenti.
   I token sono in EncryptedSharedPreferences, cifrate con una chiave del Keystore che non
   viene salvata nel backup: ripristinate su un altro dispositivo non si decifrerebbero e
   l'app andrebbe in crash all'avvio. Meglio rifare il login.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="tripflow_auth_secure.xml" />
</full-backup-content>
