<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup per Android 12+. Stesso motivo di backup_rules.xml: le preferenze cifrate con i token
   non sono ripristinabili su un altro dispositivo, quindi vanno escluse.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tripflow_auth_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tripflow_auth_secure.xml" />
    </device-transfer>
</data-extraction-rules>
